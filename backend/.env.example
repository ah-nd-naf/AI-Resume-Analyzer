# Environment variables for the AI Resume Analyzer backend.
# Copy this file to .env and fill in your actual values.

# PostgreSQL connection string (NeonDB or any Postgres provider)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Groq API key — obtain from https://console.groq.com/
GROQ_API_KEY="gsk_your_key_here"

# Comma-separated list of allowed CORS origins (defaults to localhost:3000)
ALLOWED_ORIGINS="http://localhost:3000"
